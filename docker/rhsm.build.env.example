# Example only — copy to a path outside the repo or to a gitignored name and pass at build time:
#   podman build --secret id=rhsm_build_creds,src=$HOME/rhsm.build.env ...
#   docker buildx build --secret id=rhsm_build_creds,src=$HOME/rhsm.build.env ...
#
# Use either activation key (typical for CI) or username/password — not both.

# RHSM_ORG=your_org
# RHSM_ACTIVATION_KEY=your_key

# RHSM_USERNAME=your_user
# RHSM_PASSWORD=your_password
